# 複製本檔為 .env 後再修改。.env 已列入 .gitignore，請勿提交。

# mock 後端的教師密碼。請改成你自己的值；留空時 mock 啟動會隨機產生一組並印在終端機。
TEACHER_PASSWORD=change-me

# mock 後端的連接埠
PORT=3000

# 設為 1 才會啟用 /__mock 測試鉤子（只用於自動化測試）
MOCK_TEST_HOOKS=0

# Vite 開發伺服器把 /api 與 /socket.io 代理到這個位址（mock 或真正的後端）
BACKEND_URL=http://localhost:3000

# ---------- 正式後端（server/）----------
# 正式後端的連接埠（和 mock 的 PORT 分開，兩者可以同時執行）。
# 前端改接正式後端時，把上面的 BACKEND_URL 改成 http://localhost:4000
SERVER_PORT=4000

# Google service account 金鑰檔的路徑。金鑰檔請放在 repo 以外（例如使用者家目錄），不要提交。
# 留空時後端仍可啟動，但匯入與寫回試算表會回應 SHEETS_UNAVAILABLE。
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
